# Salin ke .env lalu isi. File .env tidak boleh di-commit.

# --- Database (lihat docker-compose.yml) ---
DATABASE_URL="postgresql://wcs:wcs@localhost:5432/smartwcs?schema=public"

# --- Server ---
PORT=3000

# --- Better Auth (Bagian 1 Fase B -- diimplementasikan) ---
# WAJIB, minimal 32 karakter (secret session Better Auth). Generate: openssl rand -base64 32
AUTH_SECRET=""
# Opsional -- default http://localhost:$PORT. Isi kalau server diakses dari base URL lain (reverse proxy, dst).
AUTH_BASE_URL=""
# Username admin awal yang di-seed prisma/seed.ts (default "admin" kalau kosong).
ADMIN_USERNAME=""
# Password admin awal -- WAJIB diisi (minimal 8 karakter) supaya prisma/seed.ts membuat user admin. Jangan commit nilai asli.
ADMIN_PASSWORD=""

# --- PUDU Open Platform (Cloud API) ---
# Node region. Indonesia memakai node Overseas (Japan/Korea/Singapore).
#   Overseas : https://css-open-platform.pudutech.com/pudu-entry
#   China    : https://open-platform.pudutech.com/pudu-entry
#   Germany  : https://csg-open-platform.pudutech.com/pudu-entry
#   US       : https://csu-open-platform.pudutech.com/pudu-entry
PUDU_BASE_URL="https://css-open-platform.pudutech.com/pudu-entry"
# Didapat dari portal distributor PUDU (Application Center > Open Platform), setelah disetujui.
PUDU_API_APP_KEY=""
PUDU_API_APP_SECRET=""
# Kode yang dikirim PUDU di header CallbackCode setiap callback. Dipakai untuk verifikasi.
PUDU_CALLBACK_CODE=""
# URL publik callback WCS yang didaftarkan ke PUDU (development: lewat cloudflared tunnel).
PUDU_CALLBACK_URL="https://<nama-tunnel>.trycloudflare.com/api/integrations/pudu/callback"

# Dispatch: PuduRobotState dianggap basi setelah ini (ms), lalu dipicu getRobotStatusV2.
PUDU_ROBOT_STATE_STALE_MS="60000"
# Worker (Fase E): kirim ulang NotifyRobotReportPosition & siklus sync shop/robot/peta.
# interval (detik, bulat >= 1) dan times (bulat, maks 1000) sesuai batas resmi
# PUDU_OFFICIAL_EXCERPT.md bagian D; REFRESH_MS = margin sebelum jatah interval x times habis.
PUDU_POSE_REPORT_INTERVAL_SECONDS="2"
PUDU_POSE_REPORT_TIMES="600"
PUDU_POSE_REPORT_REFRESH_MS="600000"
PUDU_SYNC_INTERVAL_MS="300000"
# Worker (Fase E): rekonsiliasi task CALL yang tidak kunjung dapat status final.
PUDU_TASK_RECONCILE_CHECK_AFTER_MS="180000"
PUDU_TASK_RECONCILE_TIMEOUT_MS="2100000"
